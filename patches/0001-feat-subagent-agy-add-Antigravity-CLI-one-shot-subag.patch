+/**
+ * Antigravity CLI (agy) subagent provider plugin for DeepSeek Harness.
+ * Registers an out-of-process one-shot child provider on `ctx.subagents`
+ * that directly interfaces with the agy CLI's stdin/stdout/stderr.
+ *
+ * @module @deepseek-ai/dsh-subagent-agy
+ */
+
+import type { Context } from '@deepseek-ai/cordis'
+import z from '@deepseek-ai/schemastery'
+import {
+  NO_START_CAPABILITIES,
+  assertUsableCwd,
+  type ResolvedSubagentStartRequest,
+  type SubagentCapabilities,
+  type SubagentProvider,
+} from '@deepseek-ai/dsh-subagent'
+import {
+  startAgyRun,
+  type AgyRunConfig,
+} from './run.ts'
+
+export const name = 'subagent-agy'
+export const inject = ['subagents']
+
+const DEFAULT_PROVIDER_NAME = 'agy'
+
+/** Deployment configuration settings for the agy subagent provider. */
+export interface Config extends AgyRunConfig {
+  /** Registry name on `ctx.subagents` (default `agy`). */
+  providerName?: string
+}
+
+export const Config: z<Config> = z.object({
+  providerName: z.string().default(DEFAULT_PROVIDER_NAME),
+  binPath: z.string().default('agy'),
+  model: z.string(),
+  mode: z.union(['auto', 'accept-edits', 'plan'] as const).default('auto'),
+  env: z.dict(z.string()).default({}),
+  disposeGraceMs: z.number().default(3000),
+})
+
+type ResolvedConfig = Required<Pick<Config, 'providerName' | 'binPath' | 'mode' | 'env' | 'disposeGraceMs'>> &
+  Pick<Config, 'model'>
+
+class AgyProvider implements SubagentProvider {
+  readonly capabilities: SubagentCapabilities = NO_START_CAPABILITIES
+  readonly inheritsParentContext = false
+
+  constructor(
+    readonly name: string,
+    private readonly config: ResolvedConfig,
+  ) {}
+
+  start(request: ResolvedSubagentStartRequest) {
+    let cwd: string
+    try {
+      cwd = assertUsableCwd('subagent-agy', 'child cwd', request.cwd)
+    } catch (error: unknown) {
+      if (request.signal.aborted) {
+        throw new Error('subagent-agy: request was aborted before CLI startup')
+      }
+      throw error
+    }
+
+    return Promise.resolve(startAgyRun({ ...request, cwd }, this.config))
+  }
+}
+
+/**
+ * Applies the agy subagent plugin into the Cordis context.
+ *
+ * @param ctx - The Cordis application context.
+ * @param config - Provider configuration options.
+ */
+export function apply(ctx: Context, config: Config): void {
+  const resolved: ResolvedConfig = {
+    providerName: config.providerName || DEFAULT_PROVIDER_NAME,
+    binPath: config.binPath || 'agy',
+    mode: config.mode || 'auto',
+    env: config.env || {},
+    disposeGraceMs: config.disposeGraceMs ?? 3000,
+    ...(config.model !== undefined ? { model: config.model } : {}),
+  }
+
+  ctx.subagents.registerProvider(new AgyProvider(resolved.providerName, resolved))
+}
diff --git a/packages/subagent/subagent-agy/src/run.ts b/packages/subagent/subagent-agy/src/run.ts
new file mode 100644
index 0000000000..1f0f7c39ad
--- /dev/null
+++ b/packages/subagent/subagent-agy/src/run.ts
@@ -0,0 +1,155 @@
+/**
+ * One-shot Antigravity CLI (agy) subagent child lifecycle: spawn the native
+ * agy executable with -p, stream stdout/stderr, respect cancellation signals,
+ * and settle the terminal result as SubagentResult.
+ *
+ * @module @deepseek-ai/dsh-subagent-agy/run
+ */
+
+import { spawn } from 'node:child_process'
+import { randomUUID } from 'node:crypto'
+import { brandString } from '@deepseek-ai/dsh-brand'
+import type { ContentBlock } from '@deepseek-ai/dsh-llm'
+import type { SessionId } from '@deepseek-ai/dsh-session'
+import type {
+  ResolvedSubagentStartRequest,
+  SubagentResult,
+  SubagentRun,
+} from '@deepseek-ai/dsh-subagent'
+
+/** Supported execution modes for the Antigravity CLI. */
+export type AgyExecutionMode = 'auto' | 'accept-edits' | 'plan'
+
+/** Configuration options for spawning the agy subagent run. */
+export interface AgyRunConfig {
+  /** Path to the agy binary. Defaults to 'agy'. */
+  binPath?: string
+  /** Model name passed to agy via `--model`. */
+  model?: string
+  /** Agent execution mode passed to agy via `--mode`. Defaults to 'auto'. */
+  mode?: AgyExecutionMode
+  /** Additional environment variables passed to the child process. */
+  env?: Record<string, string>
+  /** Grace period in milliseconds before SIGKILL after SIGTERM. */
+  disposeGraceMs?: number
+}
+
+/**
+ * Extracts plain text from the request prompt content blocks.
+ *
+ * @param request - Resolved subagent start request containing prompt blocks.
+ * @returns Combined prompt text.
+ */
+export function extractPromptText(request: ResolvedSubagentStartRequest): string {
+  return request.prompt
+    .filter((b: ContentBlock): b is ContentBlock & { type: 'text'; text: string } => b.type === 'text')
+    .map(b => b.text)
+    .join('\n\n')
+}
+
+/**
+ * Spawns an Antigravity CLI (agy) process and returns a managed SubagentRun handle.
+ *
+ * @param request - The resolved subagent start request with absolute cwd and prompt.
+ * @param config - Options controlling binary path, model, mode, and process teardown.
+ * @returns Managed subagent run handle.
+ */
+export function startAgyRun(
+  request: ResolvedSubagentStartRequest,
+  config: AgyRunConfig = {},
+): SubagentRun {
+  const promptText = extractPromptText(request)
+  const bin = config.binPath || 'agy'
+
+  const args: string[] = [
+    '-p', promptText,
+    '--dangerously-skip-permissions',
+    '--mode', config.mode || 'auto',
+  ]
+  if (config.model) {
+    args.push('--model', config.model)
+  }
+
+  const child = spawn(bin, args, {
+    cwd: request.cwd,
+    env: { ...process.env, ...config.env },
+    stdio: ['ignore', 'pipe', 'pipe'],
+  })
+
+  let stdoutText = ''
+  let stderrText = ''
+
+  child.stdout.setEncoding('utf8')
+  child.stderr.setEncoding('utf8')
+
+  child.stdout.on('data', (chunk: string) => {
+    stdoutText += chunk
+  })
+  child.stderr.on('data', (chunk: string) => {
+    stderrText += chunk
+  })
+
+  let disposed = false
+  const dispose = (): Promise<void> => {
+    if (disposed) return Promise.resolve()
+    disposed = true
+    if (child.exitCode === null && child.signalCode === null) {
+      child.kill('SIGTERM')
+      const graceMs = config.disposeGraceMs ?? 3000
+      const timer = setTimeout(() => {
+        try {
+          child.kill('SIGKILL')
+        } catch {
+          // child process already exited
+        }
+      }, graceMs)
+      timer.unref()
+    }
+    return Promise.resolve()
+  }
+
+  const onAbort = () => {
+    void dispose()
+  }
+  request.signal.addEventListener('abort', onAbort, { once: true })
+
+  const result = new Promise<SubagentResult>((resolve) => {
+    child.on('close', (code, signal) => {
+      request.signal.removeEventListener('abort', onAbort)
+
+      if (request.signal.aborted || signal === 'SIGTERM' || signal === 'SIGKILL') {
+        resolve({
+          output: stdoutText ? [{ type: 'text', text: stdoutText.trim() }] : [],
+          diagnostic: stderrText.trim() || 'Subagent execution was aborted',
+          stopReason: 'aborted',
+        })
+      } else if (code === 0) {
+        resolve({
+          output: [{ type: 'text', text: stdoutText.trim() }],
+          stopReason: 'completed',
+        })
+      } else {
+        resolve({
+          output: stdoutText ? [{ type: 'text', text: stdoutText.trim() }] : [],
+          diagnostic: stderrText.trim() || `agy exited with code ${code}`,
+          stopReason: 'error',
+        })
+      }
+    })
+
+    child.on('error', (err) => {
+      request.signal.removeEventListener('abort', onAbort)
+      resolve({
+        output: [],
+        diagnostic: `Failed to spawn agy: ${err.message}`,
+        stopReason: 'error',
+      })
+    })
+  })
+
+  return {
+    id: brandString<SessionId>(randomUUID()),
+    result,
+    dispose,
+  }
+}
